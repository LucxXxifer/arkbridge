#!/bin/sh
# arkbridge-detect -- emit the detected primary/backup paths as JSON
# for the LuCI panel. Read-only: it never changes any configuration or route.
# A candidate's gateway is read from the kernel/netifd when possible; only when
# it cannot be read is it guessed from the subnet (.1) and marked guessed=true.
je() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

netifd_gw() {
	# Real DHCP gateway / server for a device, from netifd's status.
	ubus call network.interface dump 2>/dev/null | python3 -c '
import sys, json
dev = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for i in d.get("interface", []):
    if i.get("device") == dev:
        # Only a real (default) route nexthop is a trustworthy gateway; a
        # DHCP server or DNS server address is not necessarily the gateway.
        for r in (i.get("route") or []) + ((i.get("inactive") or {}).get("route") or []):
            if r.get("target") == "0.0.0.0" and r.get("nexthop"):
                print(r["nexthop"]); sys.exit(0)
' "$1" 2>/dev/null
}

def=$(ip -4 route show default 2>/dev/null | head -n1)
pgw=$(printf '%s\n' "$def" | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}')
pdev=$(printf '%s\n' "$def" | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
# Scope the primary gateway to its device's own default route. If it cannot be
# read from the kernel, the value is only guessed (or absent) and must be
# verified by the user.
pguessed=false
if [ -n "$pdev" ]; then
	pgw_dev=$(ip -4 route show default dev "$pdev" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}')
	if [ -n "$pgw_dev" ]; then
		pgw=$pgw_dev
	else
		pguessed=true
	fi
else
	pguessed=true
fi
[ -n "$pgw" ] || pguessed=true
pcidr=$(ip -4 route show dev "$pdev" 2>/dev/null | awk '/scope link/ {print $1; exit}')

printf '{"primary":{"gateway":"%s","device":"%s","cidr":"%s","guessed":%s},"candidates":[' \
	"$(je "$pgw")" "$(je "$pdev")" "$(je "$pcidr")" "$pguessed"
first=1
for d in /sys/class/net/*; do
	[ -e "$d" ] || continue
	i=${d##*/}
	case "$i" in
		lo|br-*|docker*|veth*|tun*|utun*|tap*|wg*|tailscale*|sit*|gre*|dummy*|teql*|erspan*|ip6tnl*|ppp*|ipsec*|@*) continue ;;
	esac
	[ "$i" = "$pdev" ] && continue
	oper=$(cat "/sys/class/net/$i/operstate" 2>/dev/null)
	car=$(cat "/sys/class/net/$i/carrier" 2>/dev/null)
	case "$oper" in
		up) ;;
		unknown) [ "$car" = "1" ] || continue ;;
		*) continue ;;
	esac
	addr=$(ip -4 -o addr show "$i" 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')
	[ -n "$addr" ] || continue
	cidr=$(ip -4 route show dev "$i" 2>/dev/null | awk '/scope link/ {print $1; exit}')
	gw=$(netifd_gw "$i")
	guessed=false
	if [ -z "$gw" ]; then
		o1=${addr%%.*}; rest=${addr#*.}; o2=${rest%%.*}; rest=${rest#*.}; o3=${rest%%.*}
		gw="$o1.$o2.$o3.1"
		guessed=true
	fi
	[ "$first" = 1 ] || printf ','
	first=0
	printf '{"device":"%s","address":"%s","cidr":"%s","gateway":"%s","guessed":%s}' \
		"$(je "$i")" "$(je "$addr")" "$(je "$cidr")" "$(je "$gw")" "$guessed"
done
printf ']}\n'
