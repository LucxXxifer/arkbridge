#!/bin/sh /etc/rc.common
# procd service that keeps the side-router failover loop running.
# shellcheck disable=SC2034
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/arkbridge loop
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Remove every object this service owns (probe routes, ip rules,
	# transparent-proxy bypass and NAT), then recompute.
	/usr/libexec/arkbridge cleanup
}

reload_service() {
	stop
	start
}
