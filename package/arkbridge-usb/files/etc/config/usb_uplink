config usb_uplink 'main'
	option enabled '1'
	option mode 'standby'
	option failover_enabled '0'
	option route_control_enabled '0'
	option interface_name 'usb_uplink'
	option proto 'dhcp'
	option metric '600'
	option primary_device 'br-lan'
	option active_metric '10'
	option standby_metric '500'
	option backup_metric '600'
	option backup_route_protocol 'static'
	option route_protocol '242'
	option failover_rounds '3'
	option candidate_seconds '60'
	option failback_seconds '300'
	option probe_interval '10'
	option probe_count '3'
	option probe_timeout '1'
	option probe_targets '223.5.5.5,119.29.29.29,180.76.76.76'
	option app_targets ''
	option ipv6_guard '1'
	option defaultroute '0'
	option peerdns '0'
	option poll_interval '5'
	option lan_bridge 'br-lan'
	option allowed_ids '12d1:14db'
	option allowed_drivers 'cdc_ether'
	option mode_switch_enabled '0'
	option mode_switch_tool 'usbmode'
	option mode_switch_config '/etc/usb-mode.json'
	option mode_switch_ids ''
	option mode_switch_retries '1'
	option mode_switch_delay '1'
