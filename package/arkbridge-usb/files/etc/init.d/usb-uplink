#!/bin/sh /etc/rc.common

# These variables are consumed by rc.common, not by this file directly.
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

PROG=/usr/libexec/usb-uplinkd
FAILOVER_PROG=/usr/libexec/usb-uplink-failoverd
PIDOF_BIN=${USB_UPLINK_PIDOF_BIN:-pidof}
SLEEP_BIN=${USB_UPLINK_SLEEP_BIN:-sleep}
STOP_WAIT_ATTEMPTS=${USB_UPLINK_STOP_WAIT_ATTEMPTS:-10}

log_msg() {
	if command -v logger >/dev/null 2>&1; then
		logger -t usb-uplink -- "$*"
	else
		printf '%s\n' "$*" >&2
	fi
}

wait_for_worker_stop() {
	worker=$1
	worker_name=${worker##*/}
	case "$STOP_WAIT_ATTEMPTS" in
		''|*[!0-9]*|0) log_msg "invalid worker stop wait attempts"; return 1 ;;
	esac
	command -v "$PIDOF_BIN" >/dev/null 2>&1 || {
		log_msg "pidof is unavailable; worker shutdown cannot be verified"
		return 1
	}
	attempt=0
	while "$PIDOF_BIN" "$worker_name" >/dev/null 2>&1; do
		attempt=$((attempt + 1))
		[ "$attempt" -lt "$STOP_WAIT_ATTEMPTS" ] || {
			log_msg "$worker_name is still running after service stop"
			return 1
		}
		"$SLEEP_BIN" 1
	done
	return 0
}

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/usb_uplink
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance failover
	procd_set_param command "$FAILOVER_PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/usb_uplink
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

service_stopped() {
	wait_for_worker_stop "$FAILOVER_PROG" || return 1
	wait_for_worker_stop "$PROG" || return 1
	"$FAILOVER_PROG" --rollback || {
		log_msg "failover rollback failed during service stop"
		return 1
	}
	"$PROG" --rollback || {
		log_msg "USB uplink rollback failed during service stop"
		return 1
	}
}

reload_service() {
	stop || return 1
	start
}

restart() {
	stop || return 1
	start
}

service_triggers() {
	procd_add_reload_trigger usb_uplink
}
